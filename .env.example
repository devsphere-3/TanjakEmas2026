# ── Midtrans ──────────────────────────────────────────────────────────────────
# Dapatkan dari: https://dashboard.midtrans.com > Settings > Access Keys
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx

# ── Backend URL ────────────────────────────────────────────────────────────────
# Vercel  : /api
# Lokal   : http://localhost:4000
VITE_BACKEND_URL=/api

# ── Supabase ───────────────────────────────────────────────────────────────────
# Dapatkan dari: https://supabase.com > Project > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (Vite) — hanya anon key yang boleh di-expose ke browser
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
